--
--:root{color-scheme:dark;--bg:#080b11;--panel:#131823;--panel2:#1b2230;--line:rgba(255,255,255,.075);--ink:#f5f7fb;--muted:#929bad;--green:#b8f36b;--red:#ff7887;--blue:#9d8bff;--accent:#b8f36b;--accent-ink:#101608;--nav-bg:rgba(11,15,23,.9);font-synthesis:none}
--*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;min-height:100vh;background:radial-gradient(ellipse at 50% -18%,#202a40 0%,#0b0f18 40%,var(--bg) 78%);color:var(--ink);font:15px/1.5 Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;-webkit-font-smoothing:antialiased}
--main{max-width:620px;margin:auto;padding:24px 18px 125px}.top{display:flex;align-items:center;justify-content:space-between;gap:14px;margin-bottom:28px}.brand{font-size:25px;font-weight:800;letter-spacing:-.07em}.muted,.hint{color:var(--muted)}.top .muted{font-size:12px;margin-top:1px}.top-actions{display:flex;gap:8px}.top-actions button{width:42px;height:42px;padding:0;border-radius:50%;font-size:18px}
--.layout{display:grid;grid-template-columns:minmax(0,1fr);gap:13px;margin-top:0}.layout>[data-page]{display:none;grid-column:1}.layout>[data-page].page-active{display:block}
--.card{min-width:0;padding:19px;border:1px solid var(--line);border-radius:24px;background:linear-gradient(145deg,rgba(24,30,43,.96),rgba(17,22,33,.98));box-shadow:0 12px 34px rgba(0,0,0,.14)}.hero{position:relative;overflow:hidden;background:radial-gradient(circle at 100% 0%,rgba(184,243,107,.12),transparent 42%),linear-gradient(145deg,#1b2930,#17202a 65%,#171d29);border-color:rgba(184,243,107,.17);padding:25px 22px}.hero:after{content:"";position:absolute;width:190px;height:190px;border:1px solid rgba(184,243,107,.08);border-radius:50%;right:-82px;bottom:-122px;box-shadow:0 0 0 18px rgba(184,243,107,.025),0 0 0 38px rgba(184,243,107,.02)}.hero small{color:#b6c2b0;letter-spacing:.09em;font-size:9px;font-weight:800}.big{font-size:clamp(38px,10vw,54px);font-weight:780;letter-spacing:-.065em;line-height:1.08;margin:13px 0 8px}.green{color:var(--green)}.red{color:var(--red)}#heroSub{font-size:12px;color:#b0bac9}
--h2{font-size:16px;letter-spacing:-.035em;margin:0 0 14px}.page-heading{display:flex;align-items:end;justify-content:space-between;margin:4px 2px 16px}.page-heading h1{margin:0;font-size:25px;letter-spacing:-.06em}.page-heading p{margin:3px 0 0;font-size:12px;color:var(--muted)}
--.quick-actions{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px;margin:0 0 14px}.quick-action{border:1px solid transparent;background:transparent;border-radius:16px;padding:8px 3px;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:7px;font-size:11px;color:#d5dbe5}.quick-action .qa-icon{width:46px;height:46px;display:grid;place-items:center;border-radius:50%;background:#252d3a;font-size:21px;color:#f3f5fa}.quick-action.active{color:var(--green)}.quick-action.active .qa-icon{background:var(--green);color:#101608;box-shadow:0 5px 18px rgba(184,243,107,.15)}
--.metrics{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}.metric{padding:14px;background:rgba(255,255,255,.035);border:1px solid rgba(255,255,255,.035);border-radius:17px;min-width:0}.metric strong{display:block;font-size:20px;letter-spacing:-.045em;overflow-wrap:anywhere;margin-top:4px}.metric span{font-size:11px;color:var(--muted)}
--label{display:block;font-size:11px;color:var(--muted);margin-bottom:6px}input,select,button{font:inherit;min-width:0;border:1px solid var(--line);background:#0f141e;color:var(--ink);padding:12px 13px;border-radius:13px;width:100%}input,select{outline:none}input:focus,select:focus{border-color:rgba(184,243,107,.55);box-shadow:0 0 0 3px rgba(184,243,107,.08)}button{cursor:pointer;font-weight:700;transition:transform .16s ease,border-color .16s ease,background .16s ease}button:active{transform:scale(.98)}button.primary{background:var(--green);color:var(--accent-ink);border-color:var(--green)}button.ghost{background:#222a38}button.danger{color:var(--red)}.formgrid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:13px}.full{grid-column:1/-1}.row{display:flex;gap:8px;align-items:center}.row>*{flex:1}.list{display:grid;gap:0}.item{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:13px 0;border-bottom:1px solid var(--line)}.item:last-child{border:0}.item strong{display:block;font-size:13px}.item small{display:block;color:var(--muted);font-size:11px;margin-top:2px}.amt{white-space:nowrap;font-weight:750;font-size:13px}.pill{display:inline-block;padding:3px 8px;border-radius:999px;background:#293341;color:#d0d8e6;font-size:10px}.bar{height:6px;background:#303847;border-radius:99px;overflow:hidden;margin-top:8px}.bar i{display:block;height:100%;background:linear-gradient(90deg,#91d957,var(--green));border-radius:99px}.hidden{display:none!important}.sectionhead{display:flex;align-items:center;justify-content:space-between;gap:8px}.sectionhead button{width:auto}.section-label{margin:5px 3px 10px;color:var(--muted);font-size:10px;text-transform:uppercase;letter-spacing:.1em;font-weight:750}.note{font-size:11px;color:var(--muted);line-height:1.55}.status{min-height:20px;color:var(--green);font-size:12px}.empty{color:var(--muted);padding:14px 0;font-size:12px}.checkbox{display:flex;align-items:center;gap:8px}.checkbox input{width:auto}.tabs{display:flex;gap:8px;flex-wrap:wrap;margin-top:16px}.tabs button{width:auto}
--.bottom-nav{position:fixed;z-index:50;bottom:calc(20px + env(safe-area-inset-bottom));left:auto;right:82px;transform:none;width:min(390px,calc(100% - 94px));min-height:66px;padding:6px 9px;background:rgba(24,30,42,.82);backdrop-filter:blur(28px) saturate(1.6);-webkit-backdrop-filter:blur(28px) saturate(1.6);border:1px solid rgba(255,255,255,.14);border-radius:24px;box-shadow:0 14px 42px #0008;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:5px}.nav-item{background:transparent;border:0;color:#8791a1;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:4px;padding:6px 3px;font-size:10px;font-weight:650;border-radius:16px;min-height:52px}.nav-item .nav-icon{width:27px;height:27px;display:grid;place-items:center;border-radius:10px;background:rgba(255,255,255,.055);color:#aeb8c8;transition:background .16s ease,color .16s ease,transform .16s ease}.nav-item .nav-icon svg{width:19px;height:19px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}.nav-item.active{color:var(--green);background:transparent}.nav-item.active .nav-icon{background:rgba(184,243,107,.15);color:var(--green);transform:translateY(-1px)}
--button:disabled{opacity:.58;cursor:wait;filter:saturate(.65)}@keyframes pocket-spin{to{transform:rotate(360deg)}}@keyframes pocket-pulse{0%,80%,100%{transform:scale(.65);opacity:.45}40%{transform:scale(1);opacity:1}}
--@media(min-width:760px){main{padding-top:32px}.bottom-nav{left:auto;right:calc(max(18px, (100vw - 620px)/2 + 18px) + 66px);transform:none;width:min(390px,calc(100% - 102px))}}
--@media(max-width:420px){main{padding:16px 13px 125px}.card{padding:16px;border-radius:20px}.formgrid{grid-template-columns:1fr}.full{grid-column:auto}.quick-actions{gap:4px}.quick-action{font-size:10px}.quick-action .qa-icon{width:43px;height:43px}.big{font-size:42px}}
