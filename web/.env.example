# MongoDB Atlas connection (finance records remain in MongoDB)
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority
DB_NAME=pocket_money_tracker

# Firebase Web App configuration (Firebase Console -> Project settings -> General -> Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# Firebase Admin SDK credentials (service account; server-only)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Public URL used in OAuth discovery and the AI API (no trailing slash).
POCKET_PUBLIC_BASE_URL=https://money.joerakesh.tech

# Pocket MCP OAuth 2.1 signing key (server-only; never commit the real values).
# Generate with: openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:3072 -out pocket-oauth-private.pem
POCKET_OAUTH_PRIVATE_KEY=
POCKET_OAUTH_KEY_ID=pocket-rsa-2026-01

# Existing MongoDB finance data stays assigned to this Google account.
OWNER_GOOGLE_EMAIL=rakeshjoe52@gmail.com
