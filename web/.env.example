# MongoDB Atlas connection (finance records remain in MongoDB)
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority
DB_NAME=pocket_money_tracker

# Firebase Web App configuration (Firebase Console -> Project settings -> General -> Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# Firebase Admin SDK credentials (service account; server-only)
# Create a dedicated service account with Firebase Authentication token verification access.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the private key exactly as provided; in Vercel use the multiline value or escaped \n.
FIREBASE_PRIVATE_KEY=

# Existing MongoDB finance data stays assigned to this Google account.
# Must exactly match the verified email returned by Firebase Authentication.
OWNER_GOOGLE_EMAIL=rakeshjoe52@gmail.com
